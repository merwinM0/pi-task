# fish completion for pi-task. No command execution or state reads during completion.
complete -c pi-task -f
complete -c pi-task -n __fish_use_subcommand -a status -d '查看最近 5 次工作（默认）'
complete -c pi-task -n __fish_use_subcommand -a start -d '创建工作并返回 ID'
complete -c pi-task -n __fish_use_subcommand -a submit -d '提交初始步骤清单'
complete -c pi-task -n __fish_use_subcommand -a add -d '增补步骤'
complete -c pi-task -n __fish_use_subcommand -a update -d '报告步骤状态'
complete -c pi-task -n __fish_use_subcommand -a finish -d '结束工作并保留记录'
complete -c pi-task -n __fish_use_subcommand -a help -d '查看帮助'
complete -c pi-task -l help -s h -d '查看帮助'
complete -c pi-task -l version -d '显示版本'
complete -c pi-task -n '__fish_seen_subcommand_from start submit add update finish status' -l id -r -d '工作 ID（查看时可省略）'
complete -c pi-task -n '__fish_seen_subcommand_from start' -l title -r -d '工作标题'
complete -c pi-task -n '__fish_seen_subcommand_from start submit' -l task -r -d '步骤标题，可重复'
complete -c pi-task -n '__fish_seen_subcommand_from start submit' -l file -r -F -d 'JSON 字符串数组文件，- 表示标准输入'
complete -c pi-task -n '__fish_seen_subcommand_from update' -l task -r -d '步骤编号'
complete -c pi-task -n '__fish_seen_subcommand_from update' -l state -r -a 'pending running done blocked cancelled' -d '步骤状态'
complete -c pi-task -n '__fish_seen_subcommand_from update' -l next -r -d '完成当前步骤并开始下一步骤'
complete -c pi-task -n '__fish_seen_subcommand_from update' -l note -r -d '完成依据或阻塞原因'
complete -c pi-task -n '__fish_seen_subcommand_from update add' -l text -r -d '步骤标题'
complete -c pi-task -n '__fish_seen_subcommand_from finish' -l state -r -a 'completed failed cancelled' -d '工作结束状态'
complete -c pi-task -n '__fish_seen_subcommand_from status' -l once -d '静态输出'
complete -c pi-task -n '__fish_seen_subcommand_from status' -l json -d '输出 JSON'
complete -c pi-task -n '__fish_seen_subcommand_from status' -l watch -d '要求交互终端实时查看'
